algoritmo "Buscas"
// Função : Exibir respostas para pesquisas
// Autor : Carolina
// Data : 18/10/2026
// Seção de Declarações 
var
pesquisa:caracter
inicio
// Seção de Comandos

escreval("O que deseja pesquisar? Opções: 1-Android 2-Windows 3-IOS")
leia(pesquisa)

ESCOLHA pesquisa

caso "1"
escreval("Sistema utilizado pela maioria dos celulares no mundo.")

caso "2"
escreval("Sistema Operacional da Microsoft usado na maioria dos computadores.")

caso "3"
escreval("Sistema utilizado em celulares da marca Apple.")

OUTROCASO
escreval("Esse item não consta em nossa lista, tente novamente.")

FIMESCOLHA

fimalgoritmo
