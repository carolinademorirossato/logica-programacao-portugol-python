algoritmo "Repetição"
// Função : Utilizar exemplo de Loop
// Autor : Carolina
// Data : 18/10/2026
// Seção de Declarações 
var
produtoLoja: caracter
loop: caracter
inicio
// Seção de Comandos

escreval("Digite o nome do Produto:")
leia(produtoLoja)

escreval("Deseja inserir mais um cadastro? SIM/NAO")
leia(loop)

ENQUANTO loop = "sim" FACA
escreval("Digite o nome do Produto:")
leia(produtoLoja)

escreval("Deseja inserir mais um cadastro? SIM/NAO")
leia(loop)

FIMENQUANTO
escreval("Cadastros realizados com sucesso!")
escreval("Obrigado por utilizar o programa")

fimalgoritmo
